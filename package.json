{
  "name": "ms2133-webhid-flasher",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/protocol-check.mjs && node scripts/backend-check.mjs",
    "check:source": "python3 scripts/check-source-only.py",
    "package:source": "python3 scripts/package-release.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "esbuild": "^0.25.12"
  },
  "description": "Browser-based MS2133 firmware backup and flashing tool using WebHID",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
